# Copy to .env (repo root) and fill in. Never commit .env.
# Empty values fall through to the defaults.

# Google Gemini key for the "why it moved" explanations (free at aistudio.google.com/apikey).
# Without it the app uses a plain headline template.
GEMINI_API_KEY=
# Optional model override (default: gemini-flash-lite-latest)
GEMINI_MODEL=

# SEC requires a User-Agent naming you, e.g. "Jane Doe jane@example.com". Needed for EDGAR search.
SEC_USER_AGENT=

# Tiger Cloud (Postgres + TimescaleDB) connection string. When set, bars live there as a hypertable
# instead of the local DuckDB file. From the Tiger console: service -> Connection -> connection string.
# postgres://tsdbadmin:<password>@<host>.tsdb.cloud.timescale.com:<port>/tsdb?sslmode=require
DD_DATABASE_URL=

# Optional: where the local DuckDB cache lives (default: backend/data/cache.duckdb)
DD_CACHE_PATH=
